<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Подключаем дефолтные конвертеры цветов и паттерны Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 1. Аппендер для обычного текста (с цветастой подсветкой Spring Boot) -->
    <appender name="TEXT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Добавляем %clr(...) для подкрашивания времени, PID, потока и уровня логов -->
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{36}){cyan} %clr(:){faint} [traceId=%X{traceId:-} spanId=%X{spanId:-}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Аппендер для JSON (только для вызовов Feign) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder" />
    </appender>

    <!-- Текстовый вывод по умолчанию для всех обычных логов -->
    <root level="INFO">
        <appender-ref ref="TEXT_CONSOLE" />
    </root>

    <!-- Логи Feign выводятся СТРОГО в JSON без дублирования в текстовую консоль -->
    <logger name="avliakulov.tymur.shop.config.CustomFeignLogger" level="INFO" additivity="false">
        <appender-ref ref="JSON_CONSOLE" />
    </logger>

</configuration>